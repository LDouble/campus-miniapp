{
  "name": "campus-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "templateInfo": {
    "name": "react-NutUI",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build": "yarn build:weapp:full && yarn build:weapp:qualification:check",
    "api:generate": "openapi-typescript ../campus_backend/api/openapi.yaml -o src/api/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "ci:check": "yarn lint && yarn typecheck && yarn test:api-environment && yarn test:course-materials && yarn test:academic-credential && yarn test:academic-calculations && yarn test:academic-schedule && yarn test:home-guest && yarn test:life-hub-refresh && yarn test:migration-guide-copy && yarn test:webview-url && yarn test:wechat-subscription && yarn test:clubs && yarn test:official-notices && yarn test:community-topic && yarn test:calendar && yarn test:empty-classroom-day-view && yarn test:daily-checkin && yarn build:weapp && yarn test:wechat-ai-submission && yarn test:wechat-ai-evaluation-dataset",
    "test:api-environment": "ts-node --transpile-only scripts/api-environment-smoke.ts",
    "test:course-materials": "ts-node --transpile-only scripts/course-materials-smoke.ts",
    "test:academic-credential": "ts-node --transpile-only scripts/academic-credential-smoke.ts",
    "test:academic-calculations": "ts-node --transpile-only scripts/academic-calculations-smoke.ts",
    "test:academic-schedule": "ts-node --transpile-only scripts/academic-schedule-smoke.ts",
    "test:home-guest": "ts-node --transpile-only scripts/home-guest-smoke.ts",
    "test:life-hub-refresh": "ts-node --transpile-only scripts/life-hub-refresh-smoke.ts",
    "test:migration-guide-copy": "ts-node --transpile-only scripts/migration-guide-copy-smoke.ts",
    "test:webview-url": "ts-node --transpile-only scripts/webview-url-smoke.ts",
    "test:wechat-subscription": "ts-node --transpile-only scripts/wechat-subscription-smoke.ts",
    "test:clubs": "ts-node --transpile-only scripts/clubs-smoke.ts",
    "test:official-notices": "ts-node --transpile-only scripts/official-notices-smoke.ts",
    "test:community-topic": "ts-node --transpile-only scripts/community-topic-smoke.ts",
    "test:qualification-build": "ts-node --transpile-only scripts/qualification-build-smoke.ts",
    "e2e:community": "npm run build:weapp && bash scripts/e2e-community.sh",
    "e2e:clubs": "npm run build:weapp && bash scripts/e2e-clubs.sh",
    "e2e:life-services": "npm run build:weapp && bash scripts/e2e-life-services.sh",
    "e2e:personal-records": "bash scripts/e2e-personal-records.sh",
    "test:calendar": "ts-node --transpile-only scripts/test-calendar.ts",
    "test:empty-classroom-day-view": "ts-node --transpile-only scripts/empty-classroom-day-view-smoke.ts",
    "test:daily-checkin": "ts-node --transpile-only scripts/daily-checkin-smoke.ts",
    "test:today-home": "ts-node --transpile-only scripts/today-home-smoke.ts",
    "test:wechat-ai": "ts-node --transpile-only scripts/wechat-ai-smoke.ts",
    "test:wechat-ai-submission": "ts-node --transpile-only scripts/wechat-ai-submission-smoke.ts",
    "test:wechat-ai-evaluation-dataset": "ts-node --transpile-only scripts/wechat-ai-evaluation-dataset-smoke.ts",
    "build:weapp": "TARO_APP_WECHAT_AI_ENABLED=0 taro build --type weapp",
    "build:weapp:full": "sh scripts/build-weapp-edition.sh full check",
    "build:weapp:full:ai": "sh scripts/build-weapp-edition.sh full ai-check",
    "build:weapp:qualification": "sh scripts/build-weapp-edition.sh qualification",
    "build:weapp:qualification:check": "sh scripts/build-weapp-edition.sh qualification check",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch"
  },
  "packageManager": "yarn@1.22.22",
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@nutui/nutui-react-taro": "^2.6.14",
    "@tarojs/components": "4.1.11",
    "@tarojs/helper": "4.1.11",
    "@tarojs/plugin-framework-react": "4.1.11",
    "@tarojs/plugin-html": "4.1.11",
    "@tarojs/plugin-platform-alipay": "4.1.11",
    "@tarojs/plugin-platform-h5": "4.1.11",
    "@tarojs/plugin-platform-jd": "4.1.11",
    "@tarojs/plugin-platform-qq": "4.1.11",
    "@tarojs/plugin-platform-swan": "4.1.11",
    "@tarojs/plugin-platform-tt": "4.1.11",
    "@tarojs/plugin-platform-weapp": "4.1.11",
    "@tarojs/react": "4.1.11",
    "@tarojs/runtime": "4.1.11",
    "@tarojs/shared": "4.1.11",
    "@tarojs/taro": "4.1.11",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.1.11",
    "@tarojs/taro-loader": "4.1.11",
    "@tarojs/webpack5-runner": "4.1.11",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "4.1.11",
    "eslint": "^8.12.0",
    "eslint-config-taro": "4.1.11",
    "eslint-plugin-import": "^2.12.0",
    "eslint-plugin-react": "^7.8.2",
    "eslint-plugin-react-hooks": "^4.2.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.4.18",
    "react-refresh": "^0.11.0",
    "stylelint": "^14.4.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "typescript": "^5.1.0",
    "webpack": "5.78.0"
  }
}
