<view wx:if="{{!hidden}}" class="tab-bar">
  <view class="tab-bar__dock">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}} {{item.pagePath === 'pages/goods/index' ? 'tab-bar__item--goods' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-bar__pill">
        <image
          class="tab-bar__icon"
          src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
          mode="aspectFit"
        />
        <view class="tab-bar__text">{{item.text}}</view>
        <view
          wx:if="{{item.pagePath === 'pages/messages/index' && unreadCount > 0}}"
          class="tab-bar__badge"
        >{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
    </view>
  </view>
</view>
