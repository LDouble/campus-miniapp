<view class="tab-bar">
  <view class="tab-item {{selected === 0 ? 'active' : ''}}" data-index="0" bindtap="switchTab"><view class="tab-icon">⌂</view><view class="tab-text">首页</view></view>
  <view class="tab-item {{selected === 1 ? 'active' : ''}}" data-index="1" bindtap="switchTab"><view class="tab-icon">◎</view><view class="tab-text">社区</view></view>
  <view class="tab-publish" bindtap="publish"><view class="tab-publish-icon"><view class="tab-publish-horizontal" /><view class="tab-publish-vertical" /></view></view>
  <view class="tab-item tab-message" bindtap="message"><view class="tab-icon">◌</view><view class="tab-text">消息</view><view class="unread-dot" /></view>
  <view class="tab-item {{selected === 2 ? 'active' : ''}}" data-index="2" bindtap="switchTab"><view class="tab-icon">●</view><view class="tab-text">我的</view></view>
</view>
