.tab-bar { position: fixed; right: 16px; bottom: 16px; left: 16px; z-index: 999; display: flex; align-items: center; justify-content: space-between; padding: 10px 18px; padding-bottom: calc(10px + env(safe-area-inset-bottom)); border: 1px solid rgba(255,255,255,.85); border-radius: 24px; background: rgba(255,255,255,.94); box-shadow: 0 8px 32px rgba(15,23,42,.1); }
.tab-item { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; color: #94a3b8; font-size: 10px; line-height: 1.2; }
.tab-item.active { color: #3b82f6; }
.tab-icon { height: 22px; font-size: 20px; line-height: 22px; }
.tab-text { margin-top: 3px; }
.tab-publish { display: flex; width: 48px; height: 48px; align-items: center; justify-content: center; margin: -28px 8px 0; border: 4px solid #f4f7fb; border-radius: 50%; background: linear-gradient(135deg,#3b82f6,#22d3ee); color: #fff; font-size: 28px; line-height: 40px; text-align: center; box-shadow: 0 8px 20px rgba(59,130,246,.35); }
