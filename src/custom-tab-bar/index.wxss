.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  height: calc(196rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-bar__dock {
  position: absolute;
  right: 46rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 46rpx;
  display: flex;
  height: 142rpx;
  padding: 0 20rpx;
  overflow: visible;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.08);
  color: #90a1b9;
  pointer-events: auto;
  backdrop-filter: blur(28rpx);
}

.tab-bar__highlight {
  position: absolute;
  top: 2rpx;
  right: 52rpx;
  left: 52rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
}

.tab-bar__item {
  position: relative;
  display: flex;
  min-width: 0;
  height: 142rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-bar__pill {
  position: relative;
  display: flex;
  width: 88rpx;
  height: 108rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  transition: opacity 180ms ease, transform 180ms ease;
}

.tab-bar__item--active .tab-bar__pill {
  background: transparent;
  transform: none;
}

.tab-bar__icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 7rpx;
  opacity: 0.9;
}

.tab-bar__text {
  color: #90a1b9;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 24rpx;
}

.tab-bar__item--active .tab-bar__text {
  color: #2b7fff;
  font-weight: 700;
}

.tab-bar__item--publish {
  justify-content: flex-start;
}

.tab-bar__publish-button {
  position: relative;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 7rpx solid #f0f4f8;
  border-radius: 50%;
  background: linear-gradient(135deg, #2b7fff, #00d3f3);
  box-shadow:
    0 16rpx 22rpx rgba(59, 130, 246, 0.4),
    inset 0 3rpx 5rpx rgba(255, 255, 255, 0.28);
  transform: translateY(-40rpx);
}

.tab-bar__publish-button::after {
  position: absolute;
  top: 10rpx;
  left: 23rpx;
  width: 42rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  content: '';
}

.tab-bar__publish-icon {
  position: relative;
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.tab-bar__publish-icon::before,
.tab-bar__publish-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 42rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #fff;
  content: '';
  transform: translate(-50%, -50%);
}

.tab-bar__publish-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.tab-bar__publish-text {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .tab-bar__pill {
    transition: none;
  }
}
