.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  height: calc(112rpx + env(safe-area-inset-bottom));
  background: var(--campus-surface, #fff);
  border-top: 1rpx solid var(--campus-border, #e8edf4);
  pointer-events: none;
}

.tab-bar__dock {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 8rpx env(safe-area-inset-bottom);
  overflow: visible;
  box-sizing: border-box;
  background: var(--campus-surface, #fff);
  color: var(--campus-text-muted, #a6b2c2);
  pointer-events: auto;
}

.tab-bar__highlight {
  display: none;
}

.tab-bar__item {
  position: relative;
  display: flex;
  min-width: 0;
  height: 112rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-bar__pill {
  position: relative;
  display: flex;
  width: 100%;
  height: 112rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 0;
}

.tab-bar__badge {
  position: absolute;
  top: 10rpx;
  left: calc(50% + 12rpx);
  display: flex;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: var(--ousea-font-size-badge, 10.48PX);
  font-weight: var(--ousea-font-weight-semibold, 600);
  line-height: 10.48PX;
  white-space: nowrap;
  background: var(--campus-danger, #e5484d);
  border: 2rpx solid var(--campus-surface, #fff);
  border-radius: var(--ousea-radius-pill, 999rpx);
  z-index: 2;
}

.tab-bar__item--active .tab-bar__pill {
  background: transparent;
  transform: none;
}

.tab-bar__icon {
  display: block;
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 2.1PX;
  opacity: 0.9;
}

.tab-bar__badge {
  position: absolute;
  top: 8rpx;
  right: 0;
  display: flex;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, .96);
  border-radius: 999rpx;
  background: #e98c70;
  color: #fff;
  font-size: 8.91PX;
  font-weight: 700;
  line-height: 8.91PX;
}

.tab-bar__text {
  color: var(--campus-text-muted, #a6b2c2);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;
  font-size: var(--campus-font-size-auxiliary, 12.58PX);
  font-weight: var(--campus-font-weight-regular, 400);
  line-height: var(--campus-line-height-auxiliary, 18.86PX);
}

.tab-bar__item--active .tab-bar__text {
  color: var(--campus-primary, #2b7aef);
  font-weight: var(--campus-font-weight-regular, 400);
}

.tab-bar__item--publish {
  justify-content: flex-start;
}

.tab-bar__publish-button {
  position: relative;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid var(--campus-surface, #fff);
  border-radius: 50%;
  background: var(--campus-primary, #2b7aef);
  transform: translateY(-16rpx);
}

.tab-bar__publish-icon {
  position: relative;
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.tab-bar__publish-icon::before,
.tab-bar__publish-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #fff;
  content: '';
  transform: translate(-50%, -50%);
}

.tab-bar__publish-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.tab-bar__publish-text {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .tab-bar__pill {
    transition: none;
  }
}

.tab-bar--dark .tab-bar__dock {
    color: var(--campus-text-muted, #8494aa);
    background: var(--campus-surface, #111827);
}

.tab-bar--dark .tab-bar__highlight {
    display: none;
}

.tab-bar--dark .tab-bar__text {
    color: var(--campus-text-muted, #8494aa);
}

.tab-bar--dark .tab-bar__item--active .tab-bar__text {
    color: var(--campus-primary, #60a5fa);
}

.tab-bar--dark .tab-bar__publish-button {
    border-color: var(--campus-surface, #111827);
    background: var(--campus-primary, #3b82f6);
}
