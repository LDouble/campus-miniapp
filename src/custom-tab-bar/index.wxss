.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  height: calc(152rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-bar__dock {
  position: absolute;
  right: 46rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  left: 46rpx;
  display: flex;
  height: 112rpx;
  padding: 0 18rpx;
  overflow: visible;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.08);
  color: #90a1b9;
  pointer-events: auto;
  backdrop-filter: blur(28rpx);
}

.tab-bar__highlight {
  position: absolute;
  top: 2rpx;
  right: 52rpx;
  left: 52rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
}

.tab-bar__item {
  position: relative;
  display: flex;
  min-width: 0;
  height: 112rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-bar__pill {
  position: relative;
  display: flex;
  width: 80rpx;
  height: 88rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  transition: opacity 180ms ease, transform 180ms ease;
}

.tab-bar__item--active .tab-bar__pill {
  background: transparent;
  transform: none;
}

.tab-bar__icon {
  display: block;
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 4rpx;
  opacity: 0.9;
}

.tab-bar__text {
  color: #90a1b9;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.tab-bar__item--active .tab-bar__text {
  color: #2b7fff;
  font-weight: 700;
}

.tab-bar__item--publish {
  justify-content: flex-start;
}

.tab-bar__publish-button {
  position: relative;
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 6rpx solid #f0f4f8;
  border-radius: 50%;
  background: linear-gradient(135deg, #2b7fff, #00d3f3);
  box-shadow:
    0 12rpx 18rpx rgba(59, 130, 246, 0.34),
    inset 0 3rpx 5rpx rgba(255, 255, 255, 0.28);
  transform: translateY(-24rpx);
}

.tab-bar__publish-button::after {
  position: absolute;
  top: 9rpx;
  left: 20rpx;
  width: 38rpx;
  height: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  content: '';
}

.tab-bar__publish-icon {
  position: relative;
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.tab-bar__publish-icon::before,
.tab-bar__publish-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #fff;
  content: '';
  transform: translate(-50%, -50%);
}

.tab-bar__publish-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.tab-bar__publish-text {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .tab-bar__pill {
    transition: none;
  }
}

@media (prefers-color-scheme: dark) {
  .tab-bar__dock {
    color: #8494aa;
    background: rgba(17, 24, 39, 0.9);
    border-color: rgba(148, 163, 184, 0.16);
    box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.34);
  }

  .tab-bar__highlight {
    background: linear-gradient(90deg, transparent, rgba(148, 163, 184, 0.24), transparent);
  }

  .tab-bar__text {
    color: #8494aa;
  }

  .tab-bar__item--active .tab-bar__text {
    color: #60a5fa;
  }

  .tab-bar__publish-button {
    border-color: #0b1220;
    background: linear-gradient(135deg, #3b82f6, #0891b2);
    box-shadow:
      0 12rpx 20rpx rgba(37, 99, 235, 0.34),
      inset 0 3rpx 5rpx rgba(255, 255, 255, 0.18);
  }
}
