/* 色源：src/pages/official-notices/index.scss 的 #f7f8f4、#4d8d7c、#294c48、#71847f；差异：源页面是可滚动的完整筛选列表，本卡片只展示接口返回的前三条，并由微信 AI 平台提供接力入口。 */
.official-notice-list-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-top: 12.58PX;
  padding-right: 3.2vw;
  padding-bottom: 12.58PX;
  padding-left: 3.2vw;
  overflow: hidden;
  background-color: #fbfcf8;
  border-top-left-radius: 1.07vw;
  border-top-right-radius: 1.07vw;
  border-bottom-right-radius: 1.07vw;
  border-bottom-left-radius: 1.07vw;
}

.official-notice-list-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8.37PX;
}

.official-notice-list-title {
  color: #294c48;
  font-size: 17.81PX;
  font-weight: 700;
  line-height: 23.15PX;
}

.official-notice-list-count {
  max-width: 35vw;
  color: #71847f;
  font-size: 12.58PX;
  line-height: 17.61PX;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.official-notice-list-items {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.official-notice-list-item {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-top: 8.37PX;
  padding-right: 2.13vw;
  padding-bottom: 8.37PX;
  padding-left: 2.13vw;
  margin-bottom: 6.29PX;
  overflow: hidden;
  background-color: #f4f7f3;
  border-left-width: 0.8vw;
  border-left-style: solid;
  border-left-color: #77a796;
  border-top-left-radius: 1.07vw;
  border-top-right-radius: 1.07vw;
  border-bottom-right-radius: 1.07vw;
  border-bottom-left-radius: 1.07vw;
}

.official-notice-list-item-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}

.official-notice-list-source {
  flex-shrink: 1;
  min-width: 0;
  color: #39796b;
  font-size: 12.58PX;
  line-height: 17.61PX;
}

.official-notice-list-category {
  flex-shrink: 1;
  max-width: 22vw;
  padding-top: 1.06PX;
  padding-right: 1.07vw;
  padding-bottom: 1.06PX;
  padding-left: 1.07vw;
  margin-left: 1.33vw;
  overflow: hidden;
  color: #4d8d7c;
  font-size: 12.58PX;
  line-height: 16.35PX;
  white-space: nowrap;
  text-overflow: ellipsis;
  background-color: #e5f2ed;
  border-top-left-radius: 0.8vw;
  border-top-right-radius: 0.8vw;
  border-bottom-right-radius: 0.8vw;
  border-bottom-left-radius: 0.8vw;
}

.official-notice-list-date {
  flex-shrink: 0;
  margin-left: auto;
  color: #71847f;
  font-size: 12.58PX;
  line-height: 17.61PX;
}

.official-notice-list-item-title {
  margin-top: 4.2PX;
  color: #294c48;
  font-size: 15.72PX;
  font-weight: 650;
  line-height: 21.22PX;
}

.official-notice-list-summary {
  margin-top: 3.14PX;
  color: #71847f;
  font-size: 12.58PX;
  line-height: 17.61PX;
}

.official-notice-list-more {
  padding-top: 2.09PX;
  color: #71847f;
  font-size: 12.58PX;
  line-height: 17.61PX;
  text-align: center;
}

.official-notice-list-handoff {
  padding-top: 8.37PX;
  color: #4d8d7c;
  font-size: 12.58PX;
  font-weight: 500;
  line-height: 17.61PX;
  text-align: center;
}

.official-notice-list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 29.35PX;
  padding-bottom: 29.35PX;
  text-align: center;
}

.official-notice-list-empty-title {
  color: #294c48;
  font-size: 15.72PX;
  font-weight: 650;
  line-height: 22.01PX;
}

.official-notice-list-empty-subtitle {
  margin-top: 6.29PX;
  color: #71847f;
  font-size: 12.58PX;
  line-height: 17.61PX;
}

.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.official-notice-list-card.official-notice-list-card--dark {
    background-color: #1f2926;
}

.official-notice-list-card--dark .official-notice-list-title {
    color: #e0ece7;
}

.official-notice-list-card--dark .official-notice-list-count {
    color: #9bacA6;
}

.official-notice-list-card--dark .official-notice-list-item {
    background-color: #293734;
    border-left-color: #78aa99;
}

.official-notice-list-card--dark .official-notice-list-source {
    color: #96c8b8;
}

.official-notice-list-card--dark .official-notice-list-category {
    color: #a6d3c5;
    background-color: #344943;
}

.official-notice-list-card--dark .official-notice-list-date {
    color: #9baca6;
}

.official-notice-list-card--dark .official-notice-list-item-title {
    color: #e0ece7;
}

.official-notice-list-card--dark .official-notice-list-summary {
    color: #a9b9b3;
}

.official-notice-list-card--dark .official-notice-list-more {
    color: #a9b9b3;
}

.official-notice-list-card--dark .official-notice-list-handoff {
    color: #96c8b8;
}

.official-notice-list-card--dark .official-notice-list-empty-title {
    color: #e0ece7;
}

.official-notice-list-card--dark .official-notice-list-empty-subtitle {
    color: #a9b9b3;
}
